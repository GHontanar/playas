{
  "name": "playas-mojacar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "scripts/download-dem.sh && scripts/download-coastline.sh && scripts/download-urban.sh && scripts/download-barreiros.sh && tsx scripts/prepare-all-beaches.ts all && npm run verify:assets",
    "data:beach": "tsx scripts/prepare-all-beaches.ts",
    "data:thumbnails": "tsx scripts/prepare-region-thumbnails.ts",
    "verify:assets": "tsx scripts/verify-assets.ts"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "suncalc": "^1.9.0",
    "three": "^0.179.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/luxon": "^3.6.2",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.179.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
